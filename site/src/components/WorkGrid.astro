---
// A grid of student work. Each item is a looping video (plays only while on
// screen), a Vimeo/YouTube embed, a live interactive sketch, a link to open
// (e.g. a game), or a still image.
import { Image } from 'astro:assets';

interface Work {
	student: string;
	title?: string | null;
	video?: string | null;
	poster?: string | null;
	embed?: string | null;
	sketch?: string | null;
	link?: string | null;
	image?: ImageMetadata | null;
	alt?: string | null;
	width?: number | null;
	height?: number | null;
}

interface Props {
	works: Work[];
	/** Used for the accessible label when a work has no alt text, e.g. "Posters that move". */
	label: string;
}
const { works, label } = Astro.props;

// Turn a normal Vimeo/YouTube page link into its embeddable player address.
function embedUrl(url: string): string {
	const yt = url.match(/(?:youtube\.com\/(?:watch\?v=|shorts\/|embed\/)|youtu\.be\/)([\w-]{6,})/);
	if (yt) return `https://www.youtube-nocookie.com/embed/${yt[1]}`;
	const vimeo = url.match(/vimeo\.com\/(?:video\/)?(\d+)(?:\/(\w+))?/);
	if (vimeo) return `https://player.vimeo.com/video/${vimeo[1]}${vimeo[2] ? `?h=${vimeo[2]}` : ''}`;
	return url;
}
---

{works.some((w) => w.sketch) && <p class="grid-hint">These are live. Move your pointer (or finger) over a sketch.</p>}
<ul class:list={['work-grid', { 'has-embeds': works.some((w) => w.embed || w.sketch || w.link) }]}>
	{
		works.map((w) => {
			const describe = w.alt ?? `${w.title ?? label} by ${w.student}`;
			return (
				<li class="work">
					{w.embed ? (
						<div class="embed">
							<iframe
								src={embedUrl(w.embed)}
								title={describe}
								loading="lazy"
								allow="fullscreen; picture-in-picture"
								allowfullscreen
							/>
						</div>
					) : w.sketch ? (
						<div
							class="sketch-frame"
							style={`aspect-ratio: ${w.width ?? 470} / ${w.height ?? 400}`}
							data-sketch={w.sketch}
							data-width={w.width ?? 470}
							data-height={w.height ?? 400}
							data-title={describe}
						/>
					) : w.link ? (
						<a class="open-tile" href={w.link} target="_blank" rel="noopener">
							<span class="open-title">{w.title ?? label}</span>
							<span class="open-action">Open in a new tab ↗</span>
						</a>
					) : w.video ? (
						<video
							src={w.video}
							poster={w.poster ?? undefined}
							width={w.width ?? undefined}
							height={w.height ?? undefined}
							aria-label={describe}
							muted
							loop
							playsinline
							preload="none"
							data-loop-video
						/>
					) : (
						w.image && <Image src={w.image} alt={describe} widths={[300, 600]} sizes="(max-width: 600px) 50vw, 260px" />
					)}
					<p class="work-credit">
						{w.title && !w.link && <span class="work-title">{w.title}</span>}
						<span>
							{w.student}
							{w.sketch && (
								<a class="open-link" href={w.sketch} target="_blank" rel="noopener" aria-label={`Open ${describe} in a new tab`}>
									open ↗
								</a>
							)}
						</span>
					</p>
				</li>
			);
		})
	}
</ul>

<style>
	.work-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
		gap: 24px 16px;
	}

	.work-grid.has-embeds {
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
	}

	.work video,
	.work :global(img) {
		display: block;
		width: 100%;
		height: auto;
		background: var(--gray-4);
	}

	.embed {
		aspect-ratio: 16 / 9;
		background: var(--color-black);
	}

	.grid-hint {
		font-family: var(--font-body);
		font-size: 13px;
		color: #555;
		margin: 0 0 14px;
	}

	.sketch-frame {
		position: relative;
		overflow: hidden;
		background: var(--gray-4);
	}

	.sketch-frame :global(iframe) {
		position: absolute;
		top: 0;
		left: 0;
		border: 0;
		transform-origin: top left;
	}

	.open-tile {
		aspect-ratio: 16 / 9;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 8px;
		background: var(--color-black);
		color: var(--color-white);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.open-tile:hover {
		color: var(--highlight);
	}

	.open-title {
		font-family: var(--font-heading);
		font-weight: 500;
		font-size: 28px;
	}

	.open-action {
		font-family: var(--font-body);
		font-size: 13px;
	}

	.open-link {
		margin-left: 8px;
		font-size: 12px;
		color: #555;
	}

	.embed iframe {
		width: 100%;
		height: 100%;
		border: 0;
		display: block;
	}

	.work-credit {
		margin: 6px 0 0;
		font-family: var(--font-body);
		font-size: 13px;
		line-height: 1.4;
		display: flex;
		flex-direction: column;
	}

	.work-title {
		font-weight: 600;
	}

	@media (max-width: 600px) {
		.work-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 20px 12px;
		}

		.work-grid.has-embeds {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	let observer: IntersectionObserver | null = null;

	function initLoopVideos() {
		observer?.disconnect();
		const videos = document.querySelectorAll<HTMLVideoElement>('[data-loop-video]');
		if (!videos.length) return;

		// People who ask for reduced motion get still frames with play controls instead.
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			videos.forEach((v) => (v.controls = true));
			return;
		}

		observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					const video = entry.target as HTMLVideoElement;
					if (entry.isIntersecting) video.play().catch(() => {});
					else video.pause();
				}
			},
			{ rootMargin: '200px 0px' }
		);
		videos.forEach((v) => observer!.observe(v));
	}

	// Live sketches: each gets an iframe at its native size, scaled to fit its tile.
	// The iframe only exists while the tile is near the screen, so a page full of
	// sketches doesn't run them all at once.
	let sketchObserver: IntersectionObserver | null = null;
	let resizeObserver: ResizeObserver | null = null;

	function fit(frame: HTMLElement) {
		const iframe = frame.querySelector('iframe');
		if (iframe) iframe.style.transform = `scale(${frame.clientWidth / Number(frame.dataset.width)})`;
	}

	function initSketches() {
		sketchObserver?.disconnect();
		resizeObserver?.disconnect();
		const frames = document.querySelectorAll<HTMLElement>('[data-sketch]');
		if (!frames.length) return;

		resizeObserver = new ResizeObserver((entries) => entries.forEach((e) => fit(e.target as HTMLElement)));
		sketchObserver = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					const frame = entry.target as HTMLElement;
					const existing = frame.querySelector('iframe');
					if (entry.isIntersecting && !existing) {
						const iframe = document.createElement('iframe');
						iframe.src = frame.dataset.sketch!;
						iframe.title = frame.dataset.title ?? '';
						iframe.width = frame.dataset.width!;
						iframe.height = frame.dataset.height!;
						iframe.setAttribute('scrolling', 'no');
						frame.appendChild(iframe);
						fit(frame);
					} else if (!entry.isIntersecting && existing) {
						existing.remove();
					}
				}
			},
			{ rootMargin: '300px 0px' }
		);
		frames.forEach((f) => {
			sketchObserver!.observe(f);
			resizeObserver!.observe(f);
		});
	}

	document.addEventListener('astro:page-load', initLoopVideos);
	document.addEventListener('astro:page-load', initSketches);
</script>
