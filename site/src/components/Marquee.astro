---
interface Props {
	text: string;
	href?: string;
}
const { text, href } = Astro.props;
const Tag = href ? 'a' : 'div';
// Each word is its own evenly-spaced item, rendered twice over, so the
// -50% loop point lands on an identical frame and the seam is invisible.
const words = Array.from({ length: 80 }, () => text);
---

<Tag class="aw-marquee-wrap" aria-label={text} {...(href ? { href } : {})}>
	<div class="aw-marquee-track" aria-hidden="true">
		{words.map((word) => <span class="aw-marquee-item">{word}</span>)}
	</div>
</Tag>

<style>
	.aw-marquee-wrap {
		display: flex;
		overflow: hidden;
		background: var(--color-black);
		height: var(--marquee-height-desktop);
		align-items: center;
		text-decoration: none;
	}

	.aw-marquee-track {
		display: flex;
		white-space: nowrap;
		animation: marqueeScroll 130s linear infinite;
	}

	.aw-marquee-wrap:hover .aw-marquee-track {
		animation-play-state: paused;
	}

	.aw-marquee-item {
		font-family: var(--font-heading);
		font-weight: 500;
		font-size: 34px;
		color: var(--color-white);
		letter-spacing: 1px;
		padding: 0 0.16em;
		transition: color 0.15s ease;
	}

	.aw-marquee-wrap:hover .aw-marquee-item {
		color: var(--highlight);
	}

	@keyframes marqueeScroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (max-width: 600px) {
		.aw-marquee-wrap {
			height: var(--marquee-height-mobile);
		}

		.aw-marquee-item {
			font-size: 24px;
		}
	}
</style>
