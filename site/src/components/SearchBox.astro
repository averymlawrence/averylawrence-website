---
// A site search field. Markup and styles only: the search behavior lives in
// MenuOverlay.astro, which is on every page and wires up every [data-search] box.
interface Props {
	/** "block" = the black SEARCH block at the bottom of the home page; "menu" = inside the + menu. */
	variant?: 'block' | 'menu';
}
const { variant = 'block' } = Astro.props;
const inputId = `search-input-${variant}`;
---

<div class:list={['search-block', variant]} data-search>
	{variant === 'menu' && <label for={inputId} class="search-label">search</label>}
	<input type="search" id={inputId} class="search-input" placeholder="" autocomplete="off" />
	{variant === 'block' && <label for={inputId} class="search-label">SEARCH</label>}
	<div class="search-results" aria-live="polite"></div>
</div>

<style>
	.search-block {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
	}

	.search-block.block {
		background: var(--color-black);
		padding: 24px 16px 32px;
	}

	.search-input {
		width: 100%;
		max-width: 480px;
		border: none;
		border-radius: var(--radius-sm);
		padding: 12px 14px;
		font-family: var(--font-body);
		font-size: 16px;
		background: var(--color-white);
		color: var(--color-black);
	}

	.block .search-label {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 13px;
		letter-spacing: 1px;
		color: var(--color-white);
	}

	.search-results {
		width: 100%;
		max-width: 480px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.search-results :global(.search-result) {
		display: flex;
		flex-direction: column;
		background: var(--color-white);
		border-radius: var(--radius-sm);
		padding: 10px 12px;
		text-decoration: none;
		gap: 2px;
	}

	.search-results :global(.search-result-title) {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 14px;
		color: var(--color-black);
	}

	.search-results :global(.search-result-excerpt) {
		font-family: var(--font-body);
		font-size: 12.5px;
		color: #444;
	}

	.search-results :global(.search-note) {
		font-family: var(--font-body);
		font-size: 12.5px;
		color: rgb(255 255 255 / 60%);
		margin: 0;
		text-align: center;
	}

	/* Inside the + menu: full width, outlined like the tag buttons. */
	.search-block.menu {
		align-items: stretch;
	}

	.menu .search-label {
		text-align: center;
		font-family: var(--font-heading);
		font-weight: 500;
		font-size: 21px;
		margin-bottom: 10px;
	}

	.menu .search-input,
	.menu .search-results {
		max-width: none;
	}

	.menu .search-input {
		border: 2px solid var(--color-black);
		padding: 14px 16px;
	}

	.menu .search-results :global(.search-result) {
		border: 2px solid var(--color-black);
	}

	.menu .search-results :global(.search-note) {
		color: #444;
	}
</style>
