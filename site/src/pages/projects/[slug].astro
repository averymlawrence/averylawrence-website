---
import { getCollection } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import ProjectBody from '../../components/ProjectBody.astro';
import Comments from '../../components/Comments.astro';
import { projectColor, projectColorTint } from '../../lib/colors';

export async function getStaticPaths() {
	const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
	return projects.map((project, i) => ({
		params: { slug: project.id },
		props: { project, rank: i + 1, total: projects.length },
	}));
}

const { project, rank, total } = Astro.props;
const { title, tags, status, overview, credits, video, video_caption, images, comments } = project.data;
const hue = project.data.hue ?? undefined;
const color = projectColor(rank, hue, total);
const tint = projectColorTint(rank, hue, total);
---

<ProjectLayout title={title} color={color} tag={tags[0]}>
	{
		status === 'coming-soon' ? (
			<div class="coming-soon">
				<p>More on this project soon.</p>
			</div>
		) : (
			<ProjectBody
				overview={overview}
				credits={credits}
				tags={tags}
				video={video}
				videoCaption={video_caption}
				images={images}
				tintColor={tint}
			/>
		)
	}
	{status === 'ready' && comments.length > 0 && <Comments comments={comments} />}
</ProjectLayout>

<style>
	.coming-soon {
		padding: 80px 16px;
		text-align: center;
		font-family: var(--font-body);
		font-size: 16px;
		color: #444;
	}
</style>
