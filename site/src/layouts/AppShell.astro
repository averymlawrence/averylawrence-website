---
import BaseHead from './BaseHead.astro';
import Header from '../components/Header.astro';
import MenuOverlay from '../components/MenuOverlay.astro';

interface Props {
	title: string;
	description?: string | null;
	image?: string | null;
}
const { title, description, image } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to content</a>
		<div class="app-shell">
			<Header />
			<div class="app-body">
				<div class="app-scroll" id="main">
					<slot />
				</div>
				<MenuOverlay />
			</div>
		</div>
	</body>
</html>

<style is:global>
	.app-shell {
		display: flex;
		flex-direction: column;
		height: 100dvh;
	}

	.app-body {
		flex: 1;
		position: relative;
		overflow: hidden;
	}

	.app-scroll {
		position: absolute;
		inset: 0;
		overflow-y: auto;
	}
</style>
